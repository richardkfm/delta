# URL of the full delta app. The embeddable widget (widget.html) links here.
# Read at build time. Leave empty to link to index.html next to the widget.
VITE_DELTA_APP_URL=https://delta.example.org/

# Imprint (Impressum), shown under /#impressum and linked from the footer.
# Read at build time. Leave VITE_IMPRINT_NAME empty to show no imprint.
VITE_IMPRINT_NAME=Erika Mustermann
VITE_IMPRINT_STREET=Musterstraße 1
VITE_IMPRINT_CITY=12345 Musterstadt
VITE_IMPRINT_EMAIL=erika@example.org
# Optional:
VITE_IMPRINT_PHONE=
VITE_IMPRINT_VAT_ID=
